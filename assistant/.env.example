# Copy to .env.local (never commit real keys).
LEDGER_URL=http://localhost:8080
LLM_PROVIDER=gemini            # gemini (default) | anthropic
GEMINI_API_KEY=                # required for Ask tab; set on Vercel for production chat
# ANTHROPIC_API_KEY=
# LLM_MODEL=                   # override the provider's default model
#
# Ask without Gemini: chat falls back to read-only ledger tools (no LLM).
# OpenRouter: not wired yet — use GEMINI_API_KEY on Vercel free tier or anthropic.
