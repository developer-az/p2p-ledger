{
  "name": "ledger-attestation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "overrides": { "tmp": "0.2.7", "zod": "4.6.6" },
  "scripts": {
    "build": "node scripts/compile.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:integration": "node --test --test-force-exit test/java-integration.mjs",
    "deploy": "node scripts/deploy.mjs",
    "verify": "node scripts/verify.mjs",
    "dev:chain": "hardhat node --network local --hostname 127.0.0.1"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "hardhat": "3.21.2",
    "solc": "0.8.38"
  }
}
