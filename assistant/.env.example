# Copy to .env.local (never commit real keys).
LEDGER_URL=http://localhost:8080
# LEDGER_DATABASE_URL=          # optional: same Postgres as ledger (Supabase pooler). F3 works when Render lacks /v1/ledger/integrity
LLM_PROVIDER=openrouter        # openrouter | gemini | anthropic — use openrouter if only OPENROUTER_API_KEY is set
# GEMINI_API_KEY=              # omit when using OpenRouter-only on Vercel
# OPENROUTER_API_KEY=          # openrouter.ai/keys
# Pick a slug from https://openrouter.ai/models (e.g. google/gemini-2.5-flash-lite). Gemini 2.0 *-001 ids are gone on OR.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_FALLBACK_MODEL=   # optional second model when Gemini primary + OR backup
# LLM_MODEL=gemini-2.0-flash-lite              # Gemini only — never an OpenRouter slug
# ANTHROPIC_API_KEY=
# LLM_MODEL=gemini-2.0-flash-lite   # default; lighter free-tier limits than flash-latest
#
# npm test never calls Gemini (see test/setup.ts). npm run eval requires ALLOW_LIVE_LLM_EVAL=1.
# Gemini 429/quota: add OPENROUTER_API_KEY on Vercel (keep GEMINI_API_KEY) and redeploy.
# Or set LLM_PROVIDER=openrouter with only OPENROUTER_API_KEY.
# Without any LLM key: chat uses read-only ledger-fallback tools.
# Full stack: npm run dev:stack (Docker ledger + Vite). Bank corridors need live Postgres.

# Password-reset email (Resend). Without both, dev prints the reset link to the server log.
# RESEND_API_KEY=
# MAIL_FROM=Settle <no-reply@your-domain>
# Public origin for emailed links
# APP_URL=https://ledger.anthony-zhou.com
