{
  "name": "ledger-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:stack": "concurrently -k -n ledger,ui -c blue,green \"docker compose -f ../docker-compose.yml up\" \"vite\"",
    "dev:server": "tsx watch --env-file-if-exists=.env.local src/server/main.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx src/server/main.ts",
    "test": "vitest run",
    "smoke:api": "tsx scripts/smoke-api.ts",
    "eval": "tsx --env-file-if-exists=.env.local evals/run.ts",
    "seed": "tsx scripts/seed.ts",
    "keys:rotate": "tsx --env-file-if-exists=.env.local scripts/rotate-keks.ts",
    "typecheck": "tsc --noEmit",
    "check:deployment": "tsx scripts/check-deployment.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:release": "tsx scripts/check-release.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@google/genai": "^3.0.0",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.17",
    "jose": "^6.2.16",
    "motion": "^14.10.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
