# Copy to .env.local (never commit real keys).
LEDGER_URL=http://localhost:8080
LLM_PROVIDER=gemini            # gemini (default) | anthropic
GEMINI_API_KEY=                # AUDIT/MSG chat on the terminal; set on Vercel for production
# ANTHROPIC_API_KEY=
# LLM_MODEL=                   # override the provider's default model
#
# Without GEMINI_API_KEY: chat falls back to read-only ledger tools (no LLM).
# Full stack: npm run dev:stack (Docker ledger + Vite). Bank corridors need live Postgres.
